{
  "name": "planningfit",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.4",
    "expo-dev-client": "~57.0.5",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "4.5.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "dev-npx": "npx expo start --dev-client",
    "dev:clean": "expo start --dev-client --clear",
    "dev:clean-npx": "npx expo start --dev-client --clear",
    "dev:tunnel-npx": "npx expo start --dev-client --tunnel --clear",
    "build:dev:android": "npx eas-cli build --profile development --platform android",
    "build:dev:ios": "npx eas-cli build --profile development --platform ios",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "lint-npx": "npx expo lint"
  },
  "private": true
}
